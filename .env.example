# Copy this file to .env for local development. Never commit real credentials.
JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional: real values are required only when testing OAuth login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: override when the backend repository is not a sibling directory.
# BACKEND_SOURCE_PATH=../KasagiChat-Background
