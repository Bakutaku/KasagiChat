# このファイルを .env にコピーして値を埋める (.env はコミットしない)
#
# GitHub OAuth App の作成: https://github.com/settings/developers
#   - Homepage URL:              http://localhost:3000
#   - Authorization callback URL: http://localhost:3000/api/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google (任意。後回しでOK): https://console.cloud.google.com/apis/credentials
#   - 承認済みリダイレクトURI: http://localhost:3000/api/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
